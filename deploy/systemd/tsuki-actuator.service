[Unit]
Description=Tsuki Actuator Daemon (Deterministic State Machine & Cgroup Actuation)
Documentation=https://github.com/snoxx-tech/tsuki
After=tsuki-guard.service

[Service]
Type=simple
Slice=tsuki-guard.slice
ExecStart=/usr/local/bin/tsuki-actuator --config /etc/tsuki/tsuki.toml
Restart=always
RestartSec=2s

User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/run/tsuki /var/lib/tsuki /sys/fs/cgroup
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
